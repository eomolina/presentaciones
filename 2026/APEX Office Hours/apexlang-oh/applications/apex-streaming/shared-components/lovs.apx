lov generos (
    name: GENEROS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT NOMBRE AS DISPLAY_VALUE, GENERO_ID AS RETURN_VALUE
            FROM STREAM_GENEROS
            ORDER BY NOMBRE,GENERO_ID
            ```
    }
    columnMapping {
        display: DISPLAY_VALUE
        return: RETURN_VALUE
    }
)
lov actores (
    name: ACTORES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT NOMBRE||' '||APELLIDO||' ('||TO_CHAR(ACTOR_ID)||')' AS DISPLAY_VALUE, ACTOR_ID AS RETURN_VALUE
            FROM STREAM_ACTORES
            ORDER BY APELLIDO,NOMBRE,ACTOR_ID
            ```
    }
    columnMapping {
        display: DISPLAY_VALUE
        return: RETURN_VALUE
    }
)
lov clientes-alquiler (
    name: CLIENTES_ALQUILER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT NOMBRE||' '||APELLIDO||' - '||EMAIL AS DISPLAY_VALUE, CLIENTE_ID AS RETURN_VALUE
            FROM STREAM_CLIENTES WHERE ACTIVO='S'
            ORDER BY APELLIDO,NOMBRE,CLIENTE_ID
            ```
    }
    columnMapping {
        display: DISPLAY_VALUE
        return: RETURN_VALUE
    }
)
lov peliculas-alquiler (
    name: PELICULAS_ALQUILER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT TITULO||' ('||TO_CHAR(PELICULA_ID)||')' AS DISPLAY_VALUE, PELICULA_ID AS RETURN_VALUE
            FROM STREAM_PELICULAS WHERE ACTIVO='S'
            ORDER BY TITULO,FECHA_ESTRENO,PELICULA_ID
            ```
    }
    columnMapping {
        display: DISPLAY_VALUE
        return: RETURN_VALUE
    }
)
