list navigation-bar (
    name: "Sesión"
    entry usuario (
        label: "&APP_USER."
        layout {
            sequence: 10
        }
    )
    entry salir (
        label: "Cerrar sesión"
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: "&LOGOUT_URL."
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )
)
