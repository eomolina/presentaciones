list navigation-menu (
    name: "Navegación"
    entry dashboard (
        label: "Dashboard"
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
                clearCache: "1"
            }
        }
        isCurrent {
            type: pages
            pages: "1"
        }
    )
    entry generos (
        label: "Géneros"
        layout {
            sequence: 20
        }
        link {
