page 10 (
    page: 10
    name: "Filmografía"
    alias: FILMOGRAFIA
    title: "Filmografía"
    appearance {
        pageMode: normal
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: required
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: "Consulte Filmografía. Los cambios se guardan al confirmar; Cancelar conserva los datos existentes."
    }
    region bc-filmografia (
        name: "Filmografía"
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
    region contexto-actor (
        name: "Actor seleccionado"
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
    pageItem P10_ACTOR_ID (
        type: hidden
        layout {
            sequence: 10
            region: @contexto-actor
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    pageItem P10_ACTOR (
        type: displayOnly
        label {
            label: "Actor"
            alignment: left
        }
        layout {
            sequence: 20
            region: @contexto-actor
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        help {
            helpText: "Indique Actor. Se aplican las restricciones del modelo; no se guarda hasta confirmar."
        }
    )
    process cargar-contexto (
        name: "cargar-contexto"
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                 IF :P10_ACTOR_ID IS NULL THEN RAISE_APPLICATION_ERROR(-20001,'Seleccione un registro padre.'); END IF;
                 SELECT NOMBRE || ' ' || APELLIDO INTO :P10_ACTOR FROM STREAM_ACTORES WHERE ACTOR_ID=:P10_ACTOR_ID;
                EXCEPTION WHEN NO_DATA_FOUND THEN RAISE_APPLICATION_ERROR(-20002,'El registro padre no existe.');
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
    button volver (
        buttonName: VOLVER
        label: "Volver"
        layout {
            sequence: 30
            region: @ir-filmografia
            slot: rightOfIRSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 8
            }
        }
    )
    region ir-filmografia (
        name: "Filmografía"
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT p.PELICULA_ID AS PELICULA_ID,
                       p.TITULO AS TITULO,
                       p.ANIO AS ANIO,
                       g.NOMBRE AS GENERO,
                       pa.PERSONAJE AS PERSONAJE,
                       pa.ORDEN_CREDITO AS ORDEN_CREDITO,
                       pa.ACTOR_ID AS ACTOR_ID,
                       pa.PELICULA_ACTOR_ID AS PELICULA_ACTOR_ID,
                       p.GENERO_ID AS GENERO_ID
                FROM STREAM_PELICULA_ACTOR pa JOIN STREAM_PELICULAS p ON p.PELICULA_ID=pa.PELICULA_ID JOIN STREAM_GENEROS g ON g.GENERO_ID=p.GENERO_ID
                WHERE pa.ACTOR_ID=:P10_ACTOR_ID
                ORDER BY p.ANIO DESC,p.TITULO,p.PELICULA_ID
                ```
            pageItemsToSubmit: "P10_ACTOR_ID"
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: "No hay registros para esta selección."
        }
        column PELICULA_ID (
            type: plainText
            heading {
                heading: "ID película"
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM999999999999990"
            }
            comments {
                comments: "Display Label: ID película; Display in Report: True; Display in Form: True; Format Mask: FM999999999999990; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.PELICULA_ID"
            }
        )
        column TITULO (
            type: plainText
            heading {
                heading: "Película"
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Película; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: True; Authorization Scheme: authenticated. Source: p.TITULO"
            }
        )
        column ANIO (
            type: plainText
            heading {
                heading: "Año"
            }
            layout {
                sequence: 30
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM999999999999990"
            }
            comments {
                comments: "Display Label: Año; Display in Report: True; Display in Form: True; Format Mask: FM999999999999990; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.ANIO"
            }
        )
        column GENERO (
            type: plainText
            heading {
                heading: "Género"
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Género; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: g.NOMBRE"
            }
        )
        column PERSONAJE (
            type: plainText
            heading {
                heading: "Personaje"
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Personaje; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: pa.PERSONAJE"
            }
        )
        column ORDEN_CREDITO (
            type: plainText
            heading {
                heading: "Orden de crédito"
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM999999999999990"
            }
            comments {
                comments: "Display Label: Orden de crédito; Display in Report: True; Display in Form: True; Format Mask: FM999999999999990; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: pa.ORDEN_CREDITO"
            }
        )
        column ACTOR_ID (
            type: hidden
            heading {
                heading: "ID actor"
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: "Display Label: ID actor; Display in Report: False; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: pa.ACTOR_ID"
            }
        )
        column PELICULA_ACTOR_ID (
            type: hidden
            heading {
                heading: "ID participación"
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: "Display Label: ID participación; Display in Report: False; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: pa.PELICULA_ACTOR_ID"
            }
        )
        column GENERO_ID (
            type: hidden
            heading {
                heading: "ID género"
            }
            layout {
                sequence: 90
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: "Display Label: ID género; Display in Report: False; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.GENERO_ID"
            }
        )
    )
)
