page 1 (
    page: 1
    name: "Dashboard"
    alias: DASHBOARD
    title: "Dashboard"
    appearance {
        pageMode: normal
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: required
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: "Consulte Dashboard. Los cambios se guardan al confirmar; Cancelar conserva los datos existentes."
    }
    region bc-dashboard (
        name: "Dashboard"
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
    region kpi-resumen (
        name: "Resumen"
        type: themeTemplateComponent/metricCard
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT '01_PELICULAS' AS METRICA_ID, 'Películas' AS ETIQUETA, COUNT(*) AS VALOR, 'Total, incluidas inactivas' AS DETALLE, 'fa-film' AS ICONO FROM STREAM_PELICULAS
                UNION ALL
                SELECT '02_ACTORES' AS METRICA_ID, 'Actores' AS ETIQUETA, COUNT(*) AS VALOR, 'Total de actores' AS DETALLE, 'fa-user' AS ICONO FROM STREAM_ACTORES
                UNION ALL
                SELECT '03_CLIENTES' AS METRICA_ID, 'Clientes' AS ETIQUETA, COUNT(*) AS VALOR, 'Total, incluidos inactivos' AS DETALLE, 'fa-users' AS ICONO FROM STREAM_CLIENTES
                UNION ALL
                SELECT '04_ESTADO_ACTIVO' AS METRICA_ID, 'Estado ACTIVO' AS ETIQUETA, COUNT(*) AS VALOR, 'Estado físico' AS DETALLE, 'fa-list' AS ICONO FROM STREAM_ALQUILERES WHERE ESTADO='ACTIVO'
                UNION ALL
                SELECT '05_ESTADO_FINALIZADO' AS METRICA_ID, 'Estado FINALIZADO' AS ETIQUETA, COUNT(*) AS VALOR, 'Estado físico' AS DETALLE, 'fa-list' AS ICONO FROM STREAM_ALQUILERES WHERE ESTADO='FINALIZADO'
                UNION ALL
                SELECT '06_ESTADO_CANCELADO' AS METRICA_ID, 'Estado CANCELADO' AS ETIQUETA, COUNT(*) AS VALOR, 'Estado físico' AS DETALLE, 'fa-list' AS ICONO FROM STREAM_ALQUILERES WHERE ESTADO='CANCELADO'
                UNION ALL
                SELECT '07_ACTIVOS_OPERATIVOS' AS METRICA_ID, 'Activos operativos' AS ETIQUETA, COUNT(*) AS VALOR, 'Pendientes de devolución' AS DETALLE, 'fa-clock-o' AS ICONO FROM STREAM_ALQUILERES WHERE ESTADO='ACTIVO' AND FECHA_DEVOLUCION IS NULL
                UNION ALL
                SELECT '08_VENCIDOS' AS METRICA_ID, 'Vencidos pendientes' AS ETIQUETA, COUNT(*) AS VALOR, 'Condición derivada, no estado' AS DETALLE, 'fa-clock-o' AS ICONO FROM STREAM_ALQUILERES WHERE ESTADO='ACTIVO' AND FECHA_DEVOLUCION IS NULL AND FECHA_VENCIMIENTO < CAST(SYSTIMESTAMP AT TIME ZONE 'America/Costa_Rica' AS TIMESTAMP)
                ORDER BY METRICA_ID
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            display: report
        }
        settings {
            title: "&ETIQUETA."
            metric: "&VALOR."
            meta: "&DETALLE."
        }
        plugin-avatar {
            displayAvatar: true
            type: icon
            icon: "&ICONO."
        }
        column METRICA_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: METRICA_ID
                dataType: varchar2
            }
        )
        column ETIQUETA (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: ETIQUETA
                dataType: varchar2
            }
        )
        column VALOR (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: VALOR
                dataType: number
            }
        )
        column DETALLE (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: DETALLE
                dataType: varchar2
            }
        )
        column ICONO (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ICONO
                dataType: varchar2
            }
        )
    )
    button acceso-1 (
        buttonName: ACCESO-1
        label: "Películas"
        layout {
            sequence: 10
            region: @kpi-resumen
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 4
                clearCache: "4"
            }
        }
    )
    button acceso-2 (
        buttonName: ACCESO-2
        label: "Actores"
        layout {
            sequence: 20
            region: @kpi-resumen
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 8
                clearCache: "8"
            }
        }
    )
    button acceso-3 (
        buttonName: ACCESO-3
        label: "Clientes"
        layout {
            sequence: 30
            region: @kpi-resumen
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: "11"
            }
        }
    )
    button acceso-4 (
        buttonName: ACCESO-4
        label: "Historial"
        layout {
            sequence: 40
            region: @kpi-resumen
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                items {
                    P13_SOLO_ACTIVOS: "N"
                }
                clearCache: "13"
            }
        }
    )
    button acceso-5 (
        buttonName: ACCESO-5
        label: "Activos"
        layout {
            sequence: 50
            region: @kpi-resumen
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 13
                items {
                    P13_SOLO_ACTIVOS: "S"
                }
                clearCache: "13"
            }
        }
    )
    button acceso-6 (
        buttonName: ACCESO-6
        label: "Vencidos"
        layout {
            sequence: 60
            region: @kpi-resumen
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 16
                clearCache: "16"
            }
        }
    )
)
