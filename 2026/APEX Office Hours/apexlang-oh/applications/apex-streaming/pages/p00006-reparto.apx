page 6 (
    page: 6
    name: "Reparto"
    alias: REPARTO
    title: "Reparto"
    appearance {
        pageMode: normal
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: required
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: "Consulte Reparto. Los cambios se guardan al confirmar; Cancelar conserva los datos existentes."
    }
    region bc-reparto (
        name: "Reparto"
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
    region contexto-pelicula (
        name: "Película seleccionada"
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
    pageItem P6_PELICULA_ID (
        type: hidden
        layout {
            sequence: 10
            region: @contexto-pelicula
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    pageItem P6_TITULO (
        type: displayOnly
        label {
            label: "Película"
            alignment: left
        }
        layout {
            sequence: 20
            region: @contexto-pelicula
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
        }
        help {
            helpText: "Indique Película. Se aplican las restricciones del modelo; no se guarda hasta confirmar."
        }
    )
    process cargar-contexto (
        name: "cargar-contexto"
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                 IF :P6_PELICULA_ID IS NULL THEN RAISE_APPLICATION_ERROR(-20001,'Seleccione un registro padre.'); END IF;
                 SELECT TITULO INTO :P6_TITULO FROM STREAM_PELICULAS WHERE PELICULA_ID=:P6_PELICULA_ID;
                EXCEPTION WHEN NO_DATA_FOUND THEN RAISE_APPLICATION_ERROR(-20002,'El registro padre no existe.');
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
    button volver (
        buttonName: VOLVER
        label: "Volver"
        layout {
            sequence: 30
            region: @ir-reparto
            slot: rightOfIRSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 4
            }
        }
    )
    region ir-reparto (
        name: "Reparto"
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT pa.PELICULA_ACTOR_ID AS PELICULA_ACTOR_ID,
                       a.NOMBRE || ' ' || a.APELLIDO AS ACTOR,
                       pa.PERSONAJE AS PERSONAJE,
                       pa.ORDEN_CREDITO AS ORDEN_CREDITO,
                       p.TITULO AS PELICULA,
                       pa.PELICULA_ID AS PELICULA_ID,
                       pa.ACTOR_ID AS ACTOR_ID
                FROM STREAM_PELICULA_ACTOR pa JOIN STREAM_ACTORES a ON a.ACTOR_ID=pa.ACTOR_ID JOIN STREAM_PELICULAS p ON p.PELICULA_ID=pa.PELICULA_ID
                WHERE pa.PELICULA_ID=:P6_PELICULA_ID
                ORDER BY pa.ORDEN_CREDITO NULLS LAST,a.APELLIDO,a.NOMBRE,pa.PELICULA_ACTOR_ID
                ```
            pageItemsToSubmit: "P6_PELICULA_ID"
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: "No hay registros para esta selección."
        }
        column PELICULA_ACTOR_ID (
            type: plainText
            heading {
                heading: "ID participación"
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM999999999999990"
            }
            link {
                target: {
                    page: 7
                    items {
                        P7_PELICULA_ACTOR_ID: "#PELICULA_ACTOR_ID#"
                        P7_PELICULA_ID: "#PELICULA_ID#"
                        P7_PADRE_ID: "&P6_PELICULA_ID."
                    }
                    clearCache: "7"
                }
                linkText: "#PELICULA_ACTOR_ID#"
            }
            comments {
                comments: "Display Label: ID participación; Display in Report: True; Display in Form: True; Format Mask: FM999999999999990; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: pa.PELICULA_ACTOR_ID"
            }
        )
        column ACTOR (
            type: plainText
            heading {
                heading: "Actor"
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Actor; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: a.NOMBRE || ' ' || a.APELLIDO"
            }
        )
        column PERSONAJE (
            type: plainText
            heading {
                heading: "Personaje"
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Personaje; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: pa.PERSONAJE"
            }
        )
        column ORDEN_CREDITO (
            type: plainText
            heading {
                heading: "Orden de crédito"
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM999999999999990"
            }
            comments {
                comments: "Display Label: Orden de crédito; Display in Report: True; Display in Form: True; Format Mask: FM999999999999990; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: pa.ORDEN_CREDITO"
            }
        )
        column PELICULA (
            type: plainText
            heading {
                heading: "Película"
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Película; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.TITULO"
            }
        )
        column PELICULA_ID (
            type: hidden
            heading {
                heading: "ID película"
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: "Display Label: ID película; Display in Report: False; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: pa.PELICULA_ID"
            }
        )
        column ACTOR_ID (
            type: hidden
            heading {
                heading: "ID actor"
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: "Display Label: ID actor; Display in Report: False; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: pa.ACTOR_ID"
            }
        )
    )
    button nuevo (
        buttonName: NUEVO
        label: "Nuevo"
        layout {
            sequence: 10
            region: @ir-reparto
            slot: rightOfIRSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 7
                items {
                    P7_PELICULA_ID: "&P6_PELICULA_ID."
                    P7_PADRE_ID: "&P6_PELICULA_ID."
                }
                clearCache: "7"
            }
        }
    )
    dynamicAction refrescar-guardar (
        name: "refrescar-guardar"
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @ir-reparto
        }
        action ejecutar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ir-reparto
            }
            execution {
                sequence: 10
                event: @refrescar-guardar
                fireOnInit: false
            }
        )
    )
    dynamicAction refrescar-cancelar (
        name: "refrescar-cancelar"
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @ir-reparto
        }
        action ejecutar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ir-reparto
            }
            execution {
                sequence: 10
                event: @refrescar-cancelar
                fireOnInit: false
            }
        )
    )
)
