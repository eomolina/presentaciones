page 8 (
    page: 8
    name: "Actores"
    alias: ACTORES
    title: "Actores"
    appearance {
        pageMode: normal
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: required
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: "Consulte Actores. Los cambios se guardan al confirmar; Cancelar conserva los datos existentes."
    }
    region bc-actores (
        name: "Actores"
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
    region ir-actores (
        name: "Actores"
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT a.ACTOR_ID AS ACTOR_ID,
                       a.NOMBRE AS NOMBRE,
                       a.APELLIDO AS APELLIDO,
                       a.FECHA_NACIMIENTO AS FECHA_NACIMIENTO,
                       a.NACIONALIDAD AS NACIONALIDAD,
                       'Filmografía' AS FILMOGRAFIA
                FROM STREAM_ACTORES a
                ORDER BY a.APELLIDO,a.NOMBRE,a.ACTOR_ID
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: "No hay registros para esta selección."
        }
        column ACTOR_ID (
            type: plainText
            heading {
                heading: "ID actor"
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM999999999999990"
            }
            link {
                target: {
                    page: 9
                    items {
                        P9_ACTOR_ID: "#ACTOR_ID#"
                    }
                    clearCache: "9"
                }
                linkText: "#ACTOR_ID#"
            }
            comments {
                comments: "Display Label: ID actor; Display in Report: True; Display in Form: True; Format Mask: FM999999999999990; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: a.ACTOR_ID"
            }
        )
        column NOMBRE (
            type: plainText
            heading {
                heading: "Nombre"
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Nombre; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: True; Authorization Scheme: authenticated. Source: a.NOMBRE"
            }
        )
        column APELLIDO (
            type: plainText
            heading {
                heading: "Apellido"
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Apellido; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: a.APELLIDO"
            }
        )
        column FECHA_NACIMIENTO (
            type: plainText
            heading {
                heading: "Nacimiento"
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
            }
            appearance {
                formatMask: "YYYY-MM-DD HH24:MI:SS"
            }
            comments {
                comments: "Display Label: Nacimiento; Display in Report: True; Display in Form: True; Format Mask: YYYY-MM-DD HH24:MI:SS; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: a.FECHA_NACIMIENTO"
            }
        )
        column NACIONALIDAD (
            type: plainText
            heading {
                heading: "Nacionalidad"
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Nacionalidad; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: a.NACIONALIDAD"
            }
        )
        column FILMOGRAFIA (
            type: plainText
            heading {
                heading: "Filmografía"
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            link {
                target: {
                    page: 10
                    items {
                        P10_ACTOR_ID: "#ACTOR_ID#"
                    }
                    clearCache: "10"
                }
                linkText: "#FILMOGRAFIA#"
            }
            comments {
                comments: "Display Label: Filmografía; Display in Report: True; Display in Form: False; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: 'Filmografía'"
            }
        )
    )
    button nuevo (
        buttonName: NUEVO
        label: "Nuevo"
        layout {
            sequence: 10
            region: @ir-actores
            slot: rightOfIRSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9
                clearCache: "9"
            }
        }
    )
    dynamicAction refrescar-guardar (
        name: "refrescar-guardar"
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @ir-actores
        }
        action ejecutar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ir-actores
            }
            execution {
                sequence: 10
                event: @refrescar-guardar
                fireOnInit: false
            }
        )
    )
    dynamicAction refrescar-cancelar (
        name: "refrescar-cancelar"
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @ir-actores
        }
        action ejecutar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ir-actores
            }
            execution {
                sequence: 10
                event: @refrescar-cancelar
                fireOnInit: false
            }
        )
    )
)
