page 4 (
    page: 4
    name: "Películas"
    alias: PELICULAS
    title: "Películas"
    appearance {
        pageMode: normal
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: required
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: "Consulte Películas. Los cambios se guardan al confirmar; Cancelar conserva los datos existentes."
    }
    region bc-peliculas (
        name: "Películas"
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )
    region ir-peliculas (
        name: "Películas"
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT p.PELICULA_ID AS PELICULA_ID,
                       p.TITULO AS TITULO,
                       g.NOMBRE AS GENERO,
                       p.ANIO AS ANIO,
                       p.DURACION_MINUTOS AS DURACION_MINUTOS,
                       p.CLASIFICACION AS CLASIFICACION,
                       p.PAIS_ORIGEN AS PAIS_ORIGEN,
                       p.FECHA_ESTRENO AS FECHA_ESTRENO,
                       p.IDIOMA AS IDIOMA,
                       p.RATING AS RATING,
                       p.ACTIVO AS ACTIVO,
                       'Reparto' AS REPARTO,
                       p.GENERO_ID AS GENERO_ID,
                       p.DESCRIPCION AS DESCRIPCION
                FROM STREAM_PELICULAS p JOIN STREAM_GENEROS g ON g.GENERO_ID=p.GENERO_ID
                ORDER BY p.TITULO,p.PELICULA_ID
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: "No hay registros para esta selección."
        }
        column PELICULA_ID (
            type: plainText
            heading {
                heading: "ID película"
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM999999999999990"
            }
            link {
                target: {
                    page: 5
                    items {
                        P5_PELICULA_ID: "#PELICULA_ID#"
                    }
                    clearCache: "5"
                }
                linkText: "#PELICULA_ID#"
            }
            comments {
                comments: "Display Label: ID película; Display in Report: True; Display in Form: True; Format Mask: FM999999999999990; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.PELICULA_ID"
            }
        )
        column TITULO (
            type: plainText
            heading {
                heading: "Título"
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Título; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: True; Authorization Scheme: authenticated. Source: p.TITULO"
            }
        )
        column GENERO (
            type: plainText
            heading {
                heading: "Género"
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Género; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: g.NOMBRE"
            }
        )
        column ANIO (
            type: plainText
            heading {
                heading: "Año"
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM999999999999990"
            }
            comments {
                comments: "Display Label: Año; Display in Report: True; Display in Form: True; Format Mask: FM999999999999990; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.ANIO"
            }
        )
        column DURACION_MINUTOS (
            type: plainText
            heading {
                heading: "Duración (min)"
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM999999999999990"
            }
            comments {
                comments: "Display Label: Duración (min); Display in Report: True; Display in Form: True; Format Mask: FM999999999999990; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.DURACION_MINUTOS"
            }
        )
        column CLASIFICACION (
            type: plainText
            heading {
                heading: "Clasificación"
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Clasificación; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.CLASIFICACION"
            }
        )
        column PAIS_ORIGEN (
            type: plainText
            heading {
                heading: "País de origen"
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: País de origen; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.PAIS_ORIGEN"
            }
        )
        column FECHA_ESTRENO (
            type: plainText
            heading {
                heading: "Fecha de estreno"
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
            appearance {
                formatMask: "YYYY-MM-DD HH24:MI:SS"
            }
            comments {
                comments: "Display Label: Fecha de estreno; Display in Report: True; Display in Form: True; Format Mask: YYYY-MM-DD HH24:MI:SS; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.FECHA_ESTRENO"
            }
        )
        column IDIOMA (
            type: plainText
            heading {
                heading: "Idioma"
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Idioma; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.IDIOMA"
            }
        )
        column RATING (
            type: plainText
            heading {
                heading: "Valoración"
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
            appearance {
                formatMask: "FM990D0"
            }
            comments {
                comments: "Display Label: Valoración; Display in Report: True; Display in Form: True; Format Mask: FM990D0; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.RATING"
            }
        )
        column ACTIVO (
            type: plainText
            heading {
                heading: "Activa"
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            comments {
                comments: "Display Label: Activa; Display in Report: True; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.ACTIVO"
            }
        )
        column REPARTO (
            type: plainText
            heading {
                heading: "Reparto"
            }
            layout {
                sequence: 120
            }
            source {
                dataType: STRING
            }
            link {
                target: {
                    page: 6
                    items {
                        P6_PELICULA_ID: "#PELICULA_ID#"
                    }
                    clearCache: "6"
                }
                linkText: "#REPARTO#"
            }
            comments {
                comments: "Display Label: Reparto; Display in Report: True; Display in Form: False; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: 'Reparto'"
            }
        )
        column GENERO_ID (
            type: hidden
            heading {
                heading: "ID género"
            }
            layout {
                sequence: 130
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: "Display Label: ID género; Display in Report: False; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.GENERO_ID"
            }
        )
        column DESCRIPCION (
            type: hidden
            heading {
                heading: "Descripción"
            }
            layout {
                sequence: 140
            }
            source {
                dataType: CLOB
            }
            comments {
                comments: "Display Label: Descripción; Display in Report: False; Display in Form: True; Format Mask: none; Value Required: see schema; Read Only: true; Primary Display Column: False; Authorization Scheme: authenticated. Source: p.DESCRIPCION"
            }
        )
    )
    button nuevo (
        buttonName: NUEVO
        label: "Nuevo"
        layout {
            sequence: 10
            region: @ir-peliculas
            slot: rightOfIRSearchBar
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: "5"
            }
        }
    )
    dynamicAction refrescar-guardar (
        name: "refrescar-guardar"
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @ir-peliculas
        }
        action ejecutar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ir-peliculas
            }
            execution {
                sequence: 10
                event: @refrescar-guardar
                fireOnInit: false
            }
        )
    )
    dynamicAction refrescar-cancelar (
        name: "refrescar-cancelar"
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @ir-peliculas
        }
        action ejecutar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @ir-peliculas
            }
            execution {
                sequence: 10
                event: @refrescar-cancelar
                fireOnInit: false
            }
        )
    )
)
